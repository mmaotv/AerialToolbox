# Gradle
.gradle/
build/
app/build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# 本机环境（不同机器路径不同，不入库）
local.properties
.idea/
*.iml
.DS_Store
Thumbs.db

# 构建产物与签名文件
dist/*.apk
dist/*.sha256
*.jks
*.keystore
# 例外：CleanYourTV 的固定 debug 签名必须进仓库，否则 CI 每次编出来的包签名都不同，
# 用户升级时会被 INSTALL_FAILED_UPDATE_INCOMPATIBLE 挡下来。它只是个 debug key
# （storepass/keypass 都是 android），公开无风险。
!upstream/cleanyourtv/debug.keystore
captures/
dist/*.png
