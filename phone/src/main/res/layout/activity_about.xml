<?xml version="1.0" encoding="utf-8"?>
<!--
  关于 / 更新手机端：与电视端「关于 / 更新工具箱」同构——版本信息 + 更新日志 + 检查更新。
  自更新走系统安装器（手机不会对自己开 ADB），安装包经 ApkProvider 以 content:// 交给安装器。

  同上：整页 LinearLayout，更新日志吃剩余高度，不套 ScrollView（否则划不动）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Text.LargeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_current" />

        <TextView
            android:id="@+id/tv_about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_about_latest"
            style="@style/Text.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/about_repo" />
    </LinearLayout>

    <TextView
        style="@style/Text.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/update_changelog" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_about_changelog"
            style="@style/Text.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/block_busy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/about_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/tv_busy_step"
            style="@style/Text.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_check"
        style="@style/Btn.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:text="@string/about_check"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_upgrade"
        style="@style/Btn.Ghost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:enabled="false"
        android:text="@string/about_upgrade"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_back"
        style="@style/Btn.Ghost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/back_to_dashboard"
        android:textSize="14sp" />
</LinearLayout>
