<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面更新页（手机端）：与电视端同一套视觉，同一套流程（查新版 → 看日志 → 下载 → 装到电视）。
  差别只在最后一公里：安装包先下到手机，再经 ADB 推到电视，由电视本机的 pm 安装。

  注意不要再套 ScrollView：外层原来是 ScrollView、更新日志又是一个固定 200dp 的 ScrollView，
  API 21 的普通 ScrollView 不做嵌套滚动，日志会完全划不动。
  现在整页是 LinearLayout，日志区吃掉剩余高度，既没有嵌套也更长。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/Text.LargeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_title" />

    <TextView
        android:id="@+id/tv_update_status"
        style="@style/Text.Callout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <!-- 版本对照 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/update_installed" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_online" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_installed_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ok"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 更新日志 -->
    <TextView
        style="@style/Text.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/update_changelog" />

    <ScrollView
        android:id="@+id/scroll_changelog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_changelog"
            style="@style/Text.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <!-- 进度 -->
    <LinearLayout
        android:id="@+id/block_busy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/tv_busy_step"
            style="@style/Text.Callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_download"
        style="@style/Btn.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:enabled="false"
        android:text="@string/update_download"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_check"
        style="@style/Btn.Ghost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/update_check"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_back"
        style="@style/Btn.Ghost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/back_to_dashboard"
        android:textSize="14sp" />
</LinearLayout>
