<?xml version="1.0" encoding="utf-8"?>
<!--
  遥控器：与 TV 端同一套视觉语言。方向键中间「确认」是主操作（品牌渐变），
  其余次操作 Fill 底，按压全部反白。

  方向键按权重三等分，不写死宽度：
  原来 110dp×3 + 10dp×2 = 350dp，而 360dp 宽的屏去掉左右内边距只剩 320dp，
  整行会溢出被裁掉两边；现在每格 = (可用宽 − 2×间距) / 3，任何屏宽都对齐。
  「上/下」用两个等宽占位 View 顶到中间列，和「确认」在同一条竖线上。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_mark">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_mark" />
        </FrameLayout>

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/remote_title" />

        <Button
            android:id="@+id/btn_close"
            style="@style/Btn.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/close"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sent"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/remote_hint" />

    <!-- 上下各留一段弹性空白，键区在剩余高度里居中，不会顶在屏幕上缘 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_up"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/remote_up"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 左 / 确认 / 右 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_left"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/remote_left"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_ok"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/remote_ok"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_right"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="@string/remote_right"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 下 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_down"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/remote_down"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 系统键 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_home"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/remote_home"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_back"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/remote_back"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_menu"
            style="@style/Btn.Ghost"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/remote_menu"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_power"
        style="@style/Btn.Ghost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/remote_power"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
