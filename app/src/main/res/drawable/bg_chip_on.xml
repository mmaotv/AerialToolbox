<?xml version="1.0" encoding="utf-8"?>
<!-- 选中的胶囊：FillStrong 底 + Hairline 描边（与手机端同一形状），和未选中的 bg_chip 只差填充浓度 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/fill_strong" />
    <stroke
        android:width="1dp"
        android:color="@color/hairline" />
    <corners android:radius="999dp" />
</shape>
