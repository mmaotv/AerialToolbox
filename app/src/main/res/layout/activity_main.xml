<?xml version="1.0" encoding="utf-8"?>
<!--
  TV 布局：一屏内完成所有操作，不需要滚动。

  首屏只回答一个问题（信息层级按「状态 → 主操作 → 次操作 → 其余」排）：
    · 顶栏        品牌标 + 标题 + 目标桌面 + 帮助 + 重新连接
    · 信息栏      一行：● 状态 · 设备 · 桌面已装版本（原来是三块并排面板）
    · 引导区      未连通调试通道时整块替代操作区，直接告诉用户「第 1 步做什么」
    · 操作区      一张主卡（独占一行）+ 一行次卡（验收 / 更新 / 更多）
    · 底部        一行操作记录

  视觉语言与上游 Aerial 一致：纯黑底、白色主文字、Fill 面板、焦点反白；
  字体走 Inter（assets/fonts/inter.ttf），字号对应上游的 Type 刻度。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!--
      裁剪必须保持默认（true）：这里曾经设过 clipChildren="false" 想让焦点放大不被裁，
      但硬件加速下一个祖先不裁剪，ScrollView 的内容就会画到自己的边界外面——
      往下滚到底部时，第一行卡片会压到顶部的信息面板上（用户看到的就是「顶部按钮重叠」）。
      焦点放大只有 3%，卡片本身有 5dp 外边距，行高由内容决定，裁掉的那 1dp 看不出来。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="16dp">

        <!-- 顶栏：品牌标 + 标题 + 目标桌面 + 帮助 + 重新连接 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_mark">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_mark" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                style="@style/Text.LargeTitle" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 目标桌面切换：两个上游互斥，装哪个由这里决定 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAerial"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip"
                    android:focusable="true"
                    android:foreground="@drawable/fg_chip_focus"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Aerial" />

                <TextView
                    android:id="@+id/chipCleanTv"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:foreground="@drawable/fg_chip_focus"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="CleanYourTV" />
            </LinearLayout>

            <!-- 帮助常驻：开 ADB 的路径以前只在连接失败的弹窗里出现一次，关掉就找不回来 -->
            <Button
                android:id="@+id/btnHelp"
                style="@style/Btn.Ghost"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:contentDescription="@string/btn_help"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="?"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRetry"
                style="@style/Btn.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="@string/reconnect"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 单条信息栏：状态点 + 设备 + 桌面状态，一行说完，不再并排三块面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/connecting"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          引导区：调试通道没通时整块顶替操作区。

          高度预算（720p = 360dp 高，扣掉顶栏/信息栏/底部只剩约 195dp）：
          标题 26 + 一行说明 16 + 一行品牌提示 18 + 错误 16 + 按钮 44 + 内边距 28 + 间距 ≈ 170dp。
          这里必须「一屏放得下」——一旦要滚动，把焦点放到「重新连接」上时系统会把内容滚到底，
          标题「第 1 步」就被顶出屏幕了（这正是上一版的问题）。
        -->
        <ScrollView
            android:id="@+id/blockGuide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/guide_title"
                    style="@style/Text.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/guide_desc"
                    style="@style/Text.Caption" />

                <TextView
                    android:id="@+id/tvGuideBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvGuideError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/warn"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGuideRetry"
                        style="@style/Btn.Primary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/guide_retry"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnGuideHelp"
                        style="@style/Btn.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/guide_more_brands"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 操作区：主卡独占一行 + 一行次卡，代码里动态填充。
             720p 的机器（高度只有 360dp）装不下时外面这层 ScrollView 兜底 -->
        <ScrollView
            android:id="@+id/actionScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/actionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="start"
            android:maxLines="2"
            android:minHeight="26dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
