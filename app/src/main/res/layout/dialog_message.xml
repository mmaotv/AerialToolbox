<?xml version="1.0" encoding="utf-8"?>
<!--
  模态弹窗内容：进度 / 结果 / 二次确认，三块互斥显示。

  它跑在独立的 Dialog 窗口里，不是一个盖在主界面上的 FrameLayout —— 这点很关键：
  同一个窗口里盖一层，焦点仍然可以留在背后的操作卡片上，按确认键就会点到被遮住的那张卡片
  （表现就是「点了『我明白了』却执行了背后的动作」「装完又从头装一遍」）。
  独立窗口天然吃掉所有按键，背景拿不到焦点。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="30dp">

        <!-- 处理中 -->
        <LinearLayout
            android:id="@+id/blockProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/working_title" />

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/percent_zero"
                android:textColor="@color/text_primary"
                android:textSize="48sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progressDrawable="@drawable/bg_progress" />

            <TextView
                android:id="@+id/tvStep"
                style="@style/Text.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/preparing" />
        </LinearLayout>

        <!-- 处理完成 -->
        <LinearLayout
            android:id="@+id/blockDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDoneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ok"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDoneDetail"
                style="@style/Text.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btnOk"
                style="@style/Btn.Primary"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/btn_ok" />
        </LinearLayout>

        <!-- 二次确认 -->
        <LinearLayout
            android:id="@+id/blockConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvConfirmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/warn"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfirmDetail"
                style="@style/Text.Callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRestoreOnly"
                    style="@style/Btn.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/restore_only" />

                <Button
                    android:id="@+id/btnRestoreUninstall"
                    style="@style/Btn.Danger"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/restore_uninstall" />

                <Button
                    android:id="@+id/btnCancel"
                    style="@style/Btn.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/cancel" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
