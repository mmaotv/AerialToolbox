<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 与本机调试通道通信；下载 Aerial 安装包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 把下载好的安装包放到公共下载目录，供安装命令读取。
         仅 Android 9 及以下需要申请，更高版本由系统放行（targetSdk 28 走传统存储策略）。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ADB 不可用时改走系统安装器；Android 8 起声明后才能拉起安装界面 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 电视/盒子没有触摸屏，必须声明为不需要，否则部分设备不允许安装 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- 保持本机 ADB 调试通道常开：开机后把 adb_enabled 写回 1（仅经 ADB 授予后才有效） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!--
          singleTask 很重要：装完桌面后要用本机 shell 的 am start 把自己叫回前台，
          standard 模式下这会重开一个实例，进度/结果弹窗连同操作状态一起没了，
          用户再按一下确认键就会从头再装一遍。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- LEANBACK_LAUNCHER：让工具出现在电视/盒子的应用列表中 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面更新页：单独一屏，进去才联网查 GitHub。
             exported=true 是为了装完 Aerial 抢到前台后，能用本机 shell 的 am start 把本页叫回来
             （非导出组件在部分固件上会被拦），页面本身没有任何自动动作，必须用户点按钮。 -->
        <activity
            android:name=".UpdateActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />

        <!-- 关于页：工具箱自己的版本、更新日志与自更新。
             exported 同为 true：装完新版会被系统重启，拉起本页能直接看到结果。 -->
        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />

        <!-- 只读地把缓存里的安装包交给系统安装器，不导出 -->
        <provider
            android:name=".apk.ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 开机 / 应用更新后重新打开 ADB（仅当用户开着「ADB 常开」）。
             亮屏恢复由 MainActivity 动态注册，这里只放白名单广播。 -->
        <receiver
            android:name=".AdbKeepAliveReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
